# ==============================================================================
# Konfigurasi Firebase Authentication untuk TitraLab (Kimia Asam Basa SMA XI)
# ==============================================================================
# Petunjuk:
# 1. Buat proyek di Firebase Console (https://console.firebase.google.com/)
# 2. Buka "Authentication" > "Sign-in method" > Aktifkan "Email/Password" dan "Google".
# 3. Buka "Project Settings" (ikon gerigi) > bagian "Your apps" > tambahkan Web App.
# 4. Salin nilai firebaseConfig ke variabel di bawah ini (atau salin berkas ini menjadi .env).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
